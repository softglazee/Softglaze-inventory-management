# Normalize all text files to LF in the repo and on checkout (silences CRLF warnings).
* text=auto eol=lf

# Shell scripts must stay LF (they run on the Linux VPS; CRLF breaks the shebang).
*.sh text eol=lf
deploy/*.conf text eol=lf

# Treat these as binary — never normalize or diff as text.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.pdf   binary
*.zip   binary
*.gz    binary
*.exe   binary
*.dll   binary
*.node  binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.eot   binary
